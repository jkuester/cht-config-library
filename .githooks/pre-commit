#!/usr/bin/env bash
#
# Formats staged .xlsx form files with `chtx form format` and re-stages them, so
# that every committed form has consistent conditional formatting applied.
#
# chtoolbox: https://github.com/jkuester/chtoolbox
#
# To bypass this hook for a single commit: git commit --no-verify

set -euo pipefail

files=()
while IFS= read -r file; do
  # Skip forms that also have unstaged changes. Formatting rewrites the working
  # tree file, so re-staging it would pull in changes that were never staged.
  git diff --quiet -- "$file" && files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -- ':(icase)*.xlsx')

[ ${#files[@]} -gt 0 ] || exit 0

node_modules/.bin/chtx form format "${files[@]}"
git add -- "${files[@]}"
